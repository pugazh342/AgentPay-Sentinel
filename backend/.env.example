
# AgentPay Sentinel - Operator Authentication (local demo)
# Provision locally; do NOT commit real hashes/secrets.
AGENTPAY_AUTH_ENABLED=true
AGENTPAY_OPERATOR_USERNAME=
# Generate: python scripts/provision_local_operator.py (interactive, writes backend/.env safely)
AGENTPAY_OPERATOR_PASSWORD_HASH=
# Generate a random secret (>= 32 bytes), e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENTPAY_OPERATOR_SESSION_SECRET=
AGENTPAY_OPERATOR_SESSION_TTL_SECONDS=3600
AGENTPAY_OPERATOR_COOKIE_SECURE=false
