AGENTPAY_HMAC_SECRET=
AGENTPAY_DATABASE_URL=sqlite:///./agentpay.db
AGENTPAY_ENVIRONMENT=local
AGENTPAY_LOG_LEVEL=INFO

# Gemini threat intelligence. Leave GEMINI_API_KEY blank to disable AI analysis;
# evaluation remains deterministic-only unless analysis_context is supplied.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENTPAY_GEMINI_TIMEOUT_MS=15000
AGENTPAY_GEMINI_MAX_RETRIES=1
AGENTPAY_GEMINI_RETRY_BACKOFF_SECONDS=0.5

# PayPal Orders v2 SANDBOX ONLY. Any value other than "sandbox" is rejected
# at startup; live payment execution is deliberately not configurable.
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
# and use its sandbox client ID and secret. Never commit real credentials.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional buyer redirect URLs. These are passed to PayPal at order creation.
PAYPAL_RETURN_URL=http://127.0.0.1:8000/docs
PAYPAL_CANCEL_URL=http://127.0.0.1:8000/docs
AGENTPAY_PAYPAL_TIMEOUT_MS=15000
AGENTPAY_PAYPAL_MAX_RETRIES=1
AGENTPAY_PAYPAL_RETRY_BACKOFF_SECONDS=0.5
AGENTPAY_PAYPAL_TOKEN_SKEW_SECONDS=60
